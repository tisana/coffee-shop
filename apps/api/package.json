{
  "name": "@coffee-shop/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/storage/migrate.ts",
    "db:seed": "tsx src/storage/seed.ts"
  },
  "dependencies": {
    "@coffee-shop/shared": "file:../../packages/shared",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.11.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.0.0",
    "express-rate-limit": "^8.5.2",
    "pg": "^8.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/csurf": "^1.11.5",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "drizzle-kit": "^0.27.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "vitest": "^4.1.8"
  }
}
